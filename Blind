<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>The World of the Blind</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', system-ui, sans-serif;
            background: #000;
            color: #666;
            min-height: 100vh;
            overflow: hidden;
            cursor: none;
        }

        /* 场景容器 */
        .scene {
            width: 100vw;
            height: 100vh;
            position: relative;
            background: #000;
        }

        /* SVG 场景层 */
        .scene-svg {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
        }

        /* 触摸圈 - 只保留中心点 */
        .touch-circle {
            position: absolute;
            width: 8px;
            height: 8px;
            pointer-events: none;
            transform: translate(-50%, -50%);
            z-index: 100;
        }

        .touch-circle::after {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            width: 3px;
            height: 3px;
            background: rgba(200, 200, 200, 0.5);
            border-radius: 50%;
            transform: translate(-50%, -50%);
            box-shadow: 0 0 8px rgba(200, 200, 200, 0.4);
        }

        /* 感知文本 - 显示2-3个核心词 */
        .sensation {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            color: rgba(220, 220, 220, 0.9);
            font-size: 1.3rem;
            text-align: center;
            pointer-events: none;
            opacity: 0;
            transition: opacity 0.2s;
            max-width: 400px;
            line-height: 2;
            text-shadow: 0 0 20px rgba(0, 0, 0, 0.9);
            z-index: 50;
            font-weight: 300;
            letter-spacing: 0.1em;
        }

        .sensation.visible {
            opacity: 1;
        }

        /* 句子区域（不可见，仅用于检测） */
        .sentence-area {
            position: absolute;
            pointer-events: none;
            opacity: 0;
        }

        /* 排序区域 - 纵向 */
        .sort-area {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            display: flex;
            flex-direction: column;
            gap: 35px;
            z-index: 5;
        }

        .sort-slot {
            display: flex;
            align-items: center;
            gap: 20px;
            position: relative;
            height: 40px;
        }

        .slot-number {
            font-size: 1.2rem;
            color: rgba(120, 120, 120, 0.5);
            font-weight: 300;
            width: 20px;
            text-align: right;
        }

        .slot-line {
            width: 250px;
            height: 1px;
            background: rgba(100, 100, 100, 0.4);
            position: relative;
            transition: background 0.3s;
        }

        .sort-slot.highlight .slot-line {
            background: rgba(150, 150, 150, 0.7);
            box-shadow: 0 0 8px rgba(150, 150, 150, 0.3);
        }

        .sort-slot.filled .slot-line {
            background: rgba(120, 180, 120, 0.6);
        }

        .slot-content {
            position: absolute;
            left: 0;
            top: -20px;
            font-size: 0.9rem;
            color: rgba(220, 220, 220, 0.85);
            white-space: nowrap;
            pointer-events: none;
        }

        /* 提示文本 */
        .instruction {
            position: absolute;
            top: 30px;
            left: 50%;
            transform: translateX(-50%);
            color: rgba(180, 180, 180, 0.6);
            font-size: 0.95rem;
            text-align: center;
            z-index: 50;
            max-width: 600px;
            line-height: 1.8;
            font-weight: 300;
        }

        /* 声音开关 */
        .sound-toggle {
            position: absolute;
            top: 20px;
            right: 20px;
            background: none;
            border: 1px solid rgba(100, 100, 100, 0.3);
            color: rgba(150, 150, 150, 0.6);
            padding: 8px 12px;
            border-radius: 4px;
            cursor: pointer;
            font-size: 0.75rem;
            transition: all 0.2s;
            z-index: 1000;
        }

        .sound-toggle:hover,
        .sound-toggle:focus {
            border-color: rgba(150, 150, 150, 0.5);
            color: rgba(180, 180, 180, 0.8);
            outline: none;
        }

        /* 拖拽指示器 */
        .drag-indicator {
            position: absolute;
            padding: 12px 20px;
            background: rgba(40, 40, 40, 0.85);
            border: 1px solid rgba(120, 120, 120, 0.4);
            border-radius: 6px;
            color: rgba(220, 220, 220, 0.9);
            font-size: 0.95rem;
            pointer-events: none;
            opacity: 0;
            transition: opacity 0.2s;
            z-index: 1001;
            font-weight: 300;
        }

        .drag-indicator.visible {
            opacity: 1;
        }

        /* 结束画面 */
        .end-screen {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.95);
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            transition: opacity 1s;
            pointer-events: none;
            z-index: 200;
        }

        .end-screen.visible {
            opacity: 1;
            pointer-events: all;
        }

        .end-message {
            text-align: center;
            color: rgba(220, 220, 220, 0.9);
            font-size: 1.4rem;
            line-height: 2.2;
            max-width: 600px;
            padding: 40px;
            font-weight: 300;
        }

        /* 屏幕阅读器 */
        .sr-only {
            position: absolute;
            width: 1px;
            height: 1px;
            padding: 0;
            margin: -1px;
            overflow: hidden;
            clip: rect(0, 0, 0, 0);
            white-space: nowrap;
            border-width: 0;
        }

        @media (max-width: 768px) {
            .sort-area {
                gap: 25px;
            }
            .slot-line {
                width: 200px;
            }
            .instruction {
                font-size: 0.85rem;
                padding: 0 20px;
            }
            .sensation {
                font-size: 1.1rem;
            }
        }

        @media (prefers-reduced-motion: reduce) {
            * {
                animation-duration: 0.01ms !important;
                transition-duration: 0.01ms !important;
            }
        }
    </style>
</head>
<body>
    <!-- 场景 -->
    <div class="scene" id="scene" role="application" aria-label="Exploration area" tabindex="0">

        <!-- SVG 场景 -->
        <svg class="scene-svg" id="sceneSvg">
            <!-- 空的SVG，仅用于未来扩展 -->
        </svg>

        <!-- 触摸圈 -->
        <div class="touch-circle" id="touchCircle"></div>

        <!-- 感知文本 - 显示2-3个关键词 -->
        <div class="sensation" id="sensation" role="status" aria-live="polite"></div>

        <!-- 拖拽指示器 -->
        <div class="drag-indicator" id="dragIndicator"></div>

        <!-- 提示文本 -->
        <div class="instruction" id="instruction">
            Touch the darkness to discover hidden words<br>
            Drag sentences to the lines by their musical pitch (higher pitch = later position)
        </div>

        <!-- 排序区域 - 纵向 -->
        <div class="sort-area" id="sortArea">
            <div class="sort-slot" data-slot="1">
                <span class="slot-number">1.</span>
                <div class="slot-line"></div>
            </div>
            <div class="sort-slot" data-slot="2">
                <span class="slot-number">2.</span>
                <div class="slot-line"></div>
            </div>
            <div class="sort-slot" data-slot="3">
                <span class="slot-number">3.</span>
                <div class="slot-line"></div>
            </div>
            <div class="sort-slot" data-slot="4">
                <span class="slot-number">4.</span>
                <div class="slot-line"></div>
            </div>
            <div class="sort-slot" data-slot="5">
                <span class="slot-number">5.</span>
                <div class="slot-line"></div>
            </div>
            <div class="sort-slot" data-slot="6">
                <span class="slot-number">6.</span>
                <div class="slot-line"></div>
            </div>
        </div>

        <!-- 结束画面 -->
        <div class="end-screen" id="endScreen">
            <div class="end-message" id="endMessage"></div>
        </div>
    </div>

    <!-- 声音开关 -->
    <button class="sound-toggle" id="soundToggle" aria-pressed="true">Sound</button>

    <!-- 屏幕阅读器 -->
    <div class="sr-only" role="status" aria-live="polite" id="liveRegion"></div>

    <script>
        // ============= 句子数据 =============
        const sentences = [
            {
                id: 1,
                text: 'Blind people cannot see the world with their eyes.',
                keywords: ['Blind', 'cannot', 'see'],
                tone: 'Do',
                freq: 261.63,
                order: 1
            },
            {
                id: 2,
                text: 'They mainly rely on touching objects to perceive their shapes and textures.',
                keywords: ['rely', 'touching', 'perceive'],
                tone: 'Re',
                freq: 293.66,
                order: 2
            },
            {
                id: 3,
                text: 'Over time, their sense of hearing becomes extremely sharp.',
                keywords: ['hearing', 'becomes', 'sharp'],
                tone: 'Mi',
                freq: 329.63,
                order: 3
            },
            {
                id: 4,
                text: 'This keen hearing helps them distinguish different objects around them.',
                keywords: ['hearing', 'distinguish', 'objects'],
                tone: 'Fa',
                freq: 349.23,
                order: 4
            },
            {
                id: 5,
                text: 'For example, they can tell the sound of a walking stick tapping the ground from other noises.',
                keywords: ['walking stick', 'tapping', 'ground'],
                tone: 'Sol',
                freq: 392.00,
                order: 5
            },
            {
                id: 6,
                text: 'These special skills let them live independently in daily life.',
                keywords: ['skills', 'live', 'independently'],
                tone: 'La',
                freq: 440.00,
                order: 6
            }
        ];

        // ============= 状态 =============
        const state = {
            soundOn: true,
            mouseX: window.innerWidth / 2,
            mouseY: window.innerHeight / 2,
            dragging: null,
            dragStartPos: null,
            sentenceAreas: [],
            slotContents: [null, null, null, null, null, null],
            completed: false,
            lastSoundTime: 0,
            lastTouchSentence: null
        };

        // ============= DOM =============
        const el = {
            scene: document.getElementById('scene'),
            touchCircle: document.getElementById('touchCircle'),
            sensation: document.getElementById('sensation'),
            dragIndicator: document.getElementById('dragIndicator'),
            instruction: document.getElementById('instruction'),
            soundToggle: document.getElementById('soundToggle'),
            live: document.getElementById('liveRegion'),
            endScreen: document.getElementById('endScreen'),
            endMessage: document.getElementById('endMessage'),
            sortArea: document.getElementById('sortArea')
        };

        // ============= 音频 =============
        const Audio = {
            ctx: null,
            init() {
                try {
                    this.ctx = new (window.AudioContext || window.webkitAudioContext)();
                } catch (e) {}
            },
            tone(freq, dur, vol = 0.2) {
                if (!state.soundOn || !this.ctx) return;
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();
                osc.connect(gain);
                gain.connect(this.ctx.destination);
                osc.frequency.value = freq;
                osc.type = 'sine';
                gain.gain.setValueAtTime(vol, this.ctx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.01, this.ctx.currentTime + dur);
                osc.start();
                osc.stop(this.ctx.currentTime + dur);
            },
            playTone(freq) {
                const now = Date.now();
                if (now - state.lastSoundTime < 300) return;
                state.lastSoundTime = now;
                this.tone(freq, 0.5);
            },
            success() {
                this.tone(523, 0.2);
                setTimeout(() => this.tone(659, 0.2), 100);
                setTimeout(() => this.tone(784, 0.25), 200);
                setTimeout(() => this.tone(1047, 0.3), 300);
            }
        };

        // ============= 初始化场景 =============
        function initScene() {
            const w = window.innerWidth;
            const h = window.innerHeight;

            // 随机打乱句子顺序
            const shuffled = [...sentences].sort(() => Math.random() - 0.5);

            // 创建句子感应区域（完全隐藏）
            state.sentenceAreas = [];

            shuffled.forEach((sentence, index) => {
                // 随机位置（避开中央排序区域）
                let x, y;
                do {
                    x = 150 + Math.random() * (w - 300);
                    y = 100 + Math.random() * (h - 200);
                } while (
                    x > w/2 - 200 && x < w/2 + 200 &&
                    y > h/2 - 200 && y < h/2 + 200
                );

                state.sentenceAreas.push({
                    id: sentence.id,
                    x: x,
                    y: y,
                    width: 300,
                    height: 80,
                    text: sentence.text,
                    keywords: sentence.keywords,
                    tone: sentence.tone,
                    freq: sentence.freq,
                    placed: false
                });
            });
        }

        // ============= 拖拽处理 =============
        function startDrag(x, y) {
            if (state.completed) return;

            // 检测是否在句子区域内
            const sentence = findSentenceAtPosition(x, y);
            if (!sentence || sentence.placed) return;

            state.dragging = sentence;
            state.dragStartPos = { x, y };

            // 显示拖拽指示器
            el.dragIndicator.textContent = sentence.text;
            el.dragIndicator.style.left = x + 'px';
            el.dragIndicator.style.top = (y - 40) + 'px';
            el.dragIndicator.classList.add('visible');

            // 播放音调
            Audio.playTone(sentence.freq);
        }

        function onMouseDown(e) {
            startDrag(e.clientX, e.clientY);
        }

        function onTouchStart(e) {
            if (e.touches.length > 0) {
                const touch = e.touches[0];
                startDrag(touch.clientX, touch.clientY);
            }
        }

        function onMouseMove(e) {
            updateTouchPosition(e.clientX, e.clientY);

            if (state.dragging) {
                e.preventDefault();
                el.dragIndicator.style.left = e.clientX + 'px';
                el.dragIndicator.style.top = (e.clientY - 40) + 'px';
                checkSlotHighlight(e.clientX, e.clientY);
            }
        }

        function onTouchMove(e) {
            if (e.touches.length === 0) return;
            const touch = e.touches[0];

            updateTouchPosition(touch.clientX, touch.clientY);

            if (state.dragging) {
                e.preventDefault();
                el.dragIndicator.style.left = touch.clientX + 'px';
                el.dragIndicator.style.top = (touch.clientY - 40) + 'px';
                checkSlotHighlight(touch.clientX, touch.clientY);
            }
        }

        function endDrag(e) {
            if (!state.dragging) return;

            const clientX = e.changedTouches ? e.changedTouches[0].clientX : e.clientX;
            const clientY = e.changedTouches ? e.changedTouches[0].clientY : e.clientY;

            const slot = findSlotAtPosition(clientX, clientY);

            if (slot) {
                placeInSlot(state.dragging, slot);
            }

            state.dragging = null;
            state.dragStartPos = null;

            // 隐藏拖拽指示器
            el.dragIndicator.classList.remove('visible');

            // 移除所有高亮
            document.querySelectorAll('.sort-slot').forEach(s => s.classList.remove('highlight'));

            checkCompletion();
        }

        function checkSlotHighlight(x, y) {
            document.querySelectorAll('.sort-slot').forEach(slot => {
                slot.classList.remove('highlight');
            });

            const slot = findSlotAtPosition(x, y);
            if (slot) {
                slot.classList.add('highlight');
            }
        }

        function findSlotAtPosition(x, y) {
            const slots = document.querySelectorAll('.sort-slot');
            for (let slot of slots) {
                const line = slot.querySelector('.slot-line');
                const rect = line.getBoundingClientRect();
                // 扩大检测区域
                if (x >= rect.left - 20 && x <= rect.right + 20 &&
                    y >= rect.top - 20 && y <= rect.bottom + 20) {
                    return slot;
                }
            }
            return null;
        }

        function findSentenceAtPosition(x, y) {
            for (let area of state.sentenceAreas) {
                if (x >= area.x - area.width/2 && x <= area.x + area.width/2 &&
                    y >= area.y - area.height/2 && y <= area.y + area.height/2) {
                    return area;
                }
            }
            return null;
        }

        function placeInSlot(sentence, slot) {
            const slotIndex = parseInt(slot.dataset.slot) - 1;

            // 如果槽位已有内容，将旧内容恢复为未放置状态
            if (state.slotContents[slotIndex]) {
                const oldSentence = state.sentenceAreas.find(s => s.id === state.slotContents[slotIndex]);
                if (oldSentence) {
                    oldSentence.placed = false;
                }
            }

            // 如果这个句子已在其他槽位，清除旧槽位
            const oldSlotIndex = state.slotContents.indexOf(sentence.id);
            if (oldSlotIndex !== -1) {
                state.slotContents[oldSlotIndex] = null;
                const oldSlot = document.querySelector(`.sort-slot[data-slot="${oldSlotIndex + 1}"]`);
                if (oldSlot) {
                    oldSlot.classList.remove('filled');
                    const oldContent = oldSlot.querySelector('.slot-content');
                    if (oldContent) oldContent.remove();
                }
            }

            // 放置句子
            state.slotContents[slotIndex] = sentence.id;
            sentence.placed = true;

            // 更新槽位显示
            slot.classList.add('filled');
            const existingContent = slot.querySelector('.slot-content');
            if (existingContent) existingContent.remove();

            const content = document.createElement('div');
            content.className = 'slot-content';
            content.textContent = sentence.text;
            slot.querySelector('.slot-line').appendChild(content);

            // 播放音调
            Audio.playTone(sentence.freq);
        }

        function checkCompletion() {
            // 检查是否所有槽位都已填充
            if (state.slotContents.some(s => s === null)) return;

            // 检查顺序是否正确
            const correct = state.slotContents.every((id, index) => id === index + 1);

            if (correct) {
                state.completed = true;
                Audio.success();

                setTimeout(() => {
                    showEnd();
                }, 1000);
            }
        }

        // ============= 触摸位置更新 =============
        function updateTouchPosition(x, y) {
            state.mouseX = x;
            state.mouseY = y;

            // 更新触摸圈位置
            el.touchCircle.style.left = x + 'px';
            el.touchCircle.style.top = y + 'px';

            // 检测触摸内容
            checkTouch(x, y);
        }

        function checkTouch(x, y) {
            if (state.dragging) {
                // 拖拽时不显示感知文本
                el.sensation.classList.remove('visible');
                return;
            }

            let text = '';
            let currentSentence = null;

            // 检测句子区域
            for (let area of state.sentenceAreas) {
                if (area.placed) continue; // 已放置的不显示

                const dist = Math.sqrt(
                    Math.pow(x - area.x, 2) +
                    Math.pow(y - area.y, 2)
                );

                if (dist < 100) {
                    // 显示2-3个关键词和音调
                    text = area.tone + '\n' + area.keywords.join(' / ');
                    currentSentence = area;

                    // 播放音调（仅当切换到新句子时）
                    if (state.lastTouchSentence !== area.id) {
                        Audio.playTone(area.freq);
                        state.lastTouchSentence = area.id;
                    }
                    break;
                }
            }

            // 更新文本
            if (text) {
                el.sensation.textContent = text;
                el.sensation.classList.add('visible');
            } else {
                el.sensation.classList.remove('visible');
                state.lastTouchSentence = null;
            }
        }

        // ============= 键盘控制 =============
        function onKeyDown(e) {
            const step = 30;
            let moved = false;

            switch(e.key) {
                case 'ArrowUp':
                    state.mouseY = Math.max(60, state.mouseY - step);
                    moved = true;
                    break;
                case 'ArrowDown':
                    state.mouseY = Math.min(window.innerHeight - 60, state.mouseY + step);
                    moved = true;
                    break;
                case 'ArrowLeft':
                    state.mouseX = Math.max(60, state.mouseX - step);
                    moved = true;
                    break;
                case 'ArrowRight':
                    state.mouseX = Math.min(window.innerWidth - 60, state.mouseX + step);
                    moved = true;
                    break;
            }

            if (moved) {
                e.preventDefault();
                updateTouchPosition(state.mouseX, state.mouseY);
            }
        }

        // ============= 结束画面 =============
        function showEnd() {
            el.instruction.style.opacity = 0;
            el.endMessage.innerHTML = 'You understood the world of the blind<br><br>In darkness, touch and hearing<br>are their ways to perceive the world';
            el.endScreen.classList.add('visible');
        }

        // ============= 辅助 =============
        function toggleSound() {
            state.soundOn = !state.soundOn;
            el.soundToggle.setAttribute('aria-pressed', state.soundOn);
        }

        function announce(msg) {
            el.live.textContent = msg;
            setTimeout(() => el.live.textContent = '', 1000);
        }

        // ============= 初始化 =============
        function init() {
            Audio.init();
            initScene();

            el.scene.addEventListener('mousemove', onMouseMove);
            el.scene.addEventListener('touchmove', onTouchMove, { passive: false });
            el.scene.addEventListener('mousedown', onMouseDown);
            el.scene.addEventListener('touchstart', onTouchStart, { passive: false });
            el.scene.addEventListener('mouseup', endDrag);
            el.scene.addEventListener('touchend', endDrag);
            el.scene.addEventListener('keydown', onKeyDown);
            el.soundToggle.addEventListener('click', toggleSound);

            window.addEventListener('resize', initScene);

            updateTouchPosition(state.mouseX, state.mouseY);
        }

        // ============= 启动 =============
        init();
    </script>
</body>
</html>
