<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>The World of the Blind</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', system-ui, sans-serif;
            background: #000;
            color: #666;
            min-height: 100vh;
            overflow: hidden;
            cursor: none;
        }

        /* 场景容器 */
        .scene {
            width: 100vw;
            height: 100vh;
            position: relative;
            background: #000;
        }

        /* SVG 场景层 */
        .scene-svg {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
        }

        /* 句子文本 - 使用遮罩只显示触摸圈内的部分 */
        .sentence-text {
            fill: rgba(220, 220, 220, 0.9);
            font-size: 19px;
            font-family: 'Segoe UI', system-ui, sans-serif;
            cursor: grab;
            user-select: none;
        }

        .sentence-text.dragging {
            cursor: grabbing;
        }

        /* 触摸圈 - 只保留中心点 */
        .touch-circle {
            position: absolute;
            width: 8px;
            height: 8px;
            pointer-events: none;
            transform: translate(-50%, -50%);
            z-index: 100;
        }

        .touch-circle::after {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            width: 3px;
            height: 3px;
            background: rgba(200, 200, 200, 0.5);
            border-radius: 50%;
            transform: translate(-50%, -50%);
            box-shadow: 0 0 8px rgba(200, 200, 200, 0.4);
        }

        /* 排序区域 - 纵向 */
        .sort-area {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            display: flex;
            flex-direction: column;
            gap: 35px;
            z-index: 5;
            pointer-events: none;
        }

        .sort-slot {
            display: flex;
            align-items: center;
            gap: 20px;
            position: relative;
            height: 40px;
        }

        .slot-number {
            font-size: 1.2rem;
            color: rgba(120, 120, 120, 0.5);
            font-weight: 300;
            width: 20px;
            text-align: right;
        }

        .slot-line {
            width: 250px;
            height: 1px;
            background: rgba(100, 100, 100, 0.4);
            position: relative;
            transition: background 0.3s;
        }

        .sort-slot.highlight .slot-line {
            background: rgba(150, 150, 150, 0.7);
            box-shadow: 0 0 8px rgba(150, 150, 150, 0.3);
        }

        .sort-slot.filled .slot-line {
            background: rgba(120, 180, 120, 0.6);
        }

        .slot-content {
            position: absolute;
            left: 0;
            top: -20px;
            font-size: 0.9rem;
            color: rgba(220, 220, 220, 0.85);
            white-space: nowrap;
            pointer-events: none;
        }

        /* 提示文本 */
        .instruction {
            position: absolute;
            top: 30px;
            left: 50%;
            transform: translateX(-50%);
            color: rgba(180, 180, 180, 0.6);
            font-size: 0.95rem;
            text-align: center;
            z-index: 50;
            max-width: 600px;
            line-height: 1.8;
            font-weight: 300;
        }

        /* 声音开关 */
        .sound-toggle {
            position: absolute;
            top: 20px;
            right: 20px;
            background: none;
            border: 1px solid rgba(100, 100, 100, 0.3);
            color: rgba(150, 150, 150, 0.6);
            padding: 8px 12px;
            border-radius: 4px;
            cursor: pointer;
            font-size: 0.75rem;
            transition: all 0.2s;
            z-index: 1000;
        }

        .sound-toggle:hover,
        .sound-toggle:focus {
            border-color: rgba(150, 150, 150, 0.5);
            color: rgba(180, 180, 180, 0.8);
            outline: none;
        }

        /* 结束画面 */
        .end-screen {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.95);
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            transition: opacity 1s;
            pointer-events: none;
            z-index: 200;
        }

        .end-screen.visible {
            opacity: 1;
            pointer-events: all;
        }

        .end-message {
            text-align: center;
            color: rgba(220, 220, 220, 0.9);
            font-size: 1.4rem;
            line-height: 2.2;
            max-width: 600px;
            padding: 40px;
            font-weight: 300;
        }

        /* 屏幕阅读器 */
        .sr-only {
            position: absolute;
            width: 1px;
            height: 1px;
            padding: 0;
            margin: -1px;
            overflow: hidden;
            clip: rect(0, 0, 0, 0);
            white-space: nowrap;
            border-width: 0;
        }

        @media (max-width: 768px) {
            .sort-area {
                gap: 25px;
            }
            .slot-line {
                width: 200px;
            }
            .instruction {
                font-size: 0.85rem;
                padding: 0 20px;
            }
            .sentence-text {
                font-size: 17px;
            }
        }

        @media (prefers-reduced-motion: reduce) {
            * {
                animation-duration: 0.01ms !important;
                transition-duration: 0.01ms !important;
            }
        }
    </style>
</head>
<body>
    <!-- 场景 -->
    <div class="scene" id="scene" role="application" aria-label="Exploration area" tabindex="0">

        <!-- SVG 场景 - 句子只在触摸圈内可见 -->
        <svg class="scene-svg" id="sceneSvg">
            <defs>
                <!-- 圆形遮罩 - 只显示触摸圈内的内容 -->
                <radialGradient id="touchGradient">
                    <stop offset="0%" stop-color="white" stop-opacity="1"/>
                    <stop offset="50%" stop-color="white" stop-opacity="0.8"/>
                    <stop offset="80%" stop-color="white" stop-opacity="0.3"/>
                    <stop offset="100%" stop-color="white" stop-opacity="0"/>
                </radialGradient>
                <mask id="touchMask">
                    <rect width="100%" height="100%" fill="black"/>
                    <circle id="maskCircle" r="50" fill="url(#touchGradient)"/>
                </mask>
            </defs>

            <!-- 句子层 - 应用遮罩 -->
            <g id="sentenceLayer" mask="url(#touchMask)"></g>
        </svg>

        <!-- 触摸圈 -->
        <div class="touch-circle" id="touchCircle"></div>

        <!-- 提示文本 -->
        <div class="instruction" id="instruction">
            Touch the darkness to reveal hidden sentences<br>
            Drag them to the lines by their musical pitch (higher pitch = later position)
        </div>

        <!-- 排序区域 - 纵向 -->
        <div class="sort-area" id="sortArea">
            <div class="sort-slot" data-slot="1">
                <span class="slot-number">1.</span>
                <div class="slot-line"></div>
            </div>
            <div class="sort-slot" data-slot="2">
                <span class="slot-number">2.</span>
                <div class="slot-line"></div>
            </div>
            <div class="sort-slot" data-slot="3">
                <span class="slot-number">3.</span>
                <div class="slot-line"></div>
            </div>
            <div class="sort-slot" data-slot="4">
                <span class="slot-number">4.</span>
                <div class="slot-line"></div>
            </div>
            <div class="sort-slot" data-slot="5">
                <span class="slot-number">5.</span>
                <div class="slot-line"></div>
            </div>
            <div class="sort-slot" data-slot="6">
                <span class="slot-number">6.</span>
                <div class="slot-line"></div>
            </div>
        </div>

        <!-- 结束画面 -->
        <div class="end-screen" id="endScreen">
            <div class="end-message" id="endMessage"></div>
        </div>
    </div>

    <!-- 声音开关 -->
    <button class="sound-toggle" id="soundToggle" aria-pressed="true">Sound</button>

    <!-- 屏幕阅读器 -->
    <div class="sr-only" role="status" aria-live="polite" id="liveRegion"></div>

    <script>
        // ============= 句子数据 =============
        const sentences = [
            {
                id: 1,
                text: 'Blind people cannot see the world with their eyes.',
                tone: 'Do',
                freq: 261.63,
                order: 1
            },
            {
                id: 2,
                text: 'They mainly rely on touching objects to perceive their shapes and textures.',
                tone: 'Re',
                freq: 293.66,
                order: 2
            },
            {
                id: 3,
                text: 'Over time, their sense of hearing becomes extremely sharp.',
                tone: 'Mi',
                freq: 329.63,
                order: 3
            },
            {
                id: 4,
                text: 'This keen hearing helps them distinguish different objects around them.',
                tone: 'Fa',
                freq: 349.23,
                order: 4
            },
            {
                id: 5,
                text: 'For example, they can tell the sound of a walking stick tapping the ground from other noises.',
                tone: 'Sol',
                freq: 392.00,
                order: 5
            },
            {
                id: 6,
                text: 'These special skills let them live independently in daily life.',
                tone: 'La',
                freq: 440.00,
                order: 6
            }
        ];

        // ============= 状态 =============
        const state = {
            soundOn: true,
            mouseX: window.innerWidth / 2,
            mouseY: window.innerHeight / 2,
            dragging: null,
            dragOffset: { x: 0, y: 0 },
            sentenceElements: [],
            slotContents: [null, null, null, null, null, null],
            completed: false,
            lastSoundTime: 0
        };

        // ============= DOM =============
        const el = {
            scene: document.getElementById('scene'),
            sceneSvg: document.getElementById('sceneSvg'),
            maskCircle: document.getElementById('maskCircle'),
            touchCircle: document.getElementById('touchCircle'),
            instruction: document.getElementById('instruction'),
            soundToggle: document.getElementById('soundToggle'),
            live: document.getElementById('liveRegion'),
            endScreen: document.getElementById('endScreen'),
            endMessage: document.getElementById('endMessage'),
            sortArea: document.getElementById('sortArea'),
            sentenceLayer: document.getElementById('sentenceLayer')
        };

        // ============= 音频 =============
        const Audio = {
            ctx: null,
            init() {
                try {
                    this.ctx = new (window.AudioContext || window.webkitAudioContext)();
                } catch (e) {}
            },
            tone(freq, dur, vol = 0.2) {
                if (!state.soundOn || !this.ctx) return;
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();
                osc.connect(gain);
                gain.connect(this.ctx.destination);
                osc.frequency.value = freq;
                osc.type = 'sine';
                gain.gain.setValueAtTime(vol, this.ctx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.01, this.ctx.currentTime + dur);
                osc.start();
                osc.stop(this.ctx.currentTime + dur);
            },
            playTone(freq) {
                const now = Date.now();
                if (now - state.lastSoundTime < 300) return;
                state.lastSoundTime = now;
                this.tone(freq, 0.5);
            },
            success() {
                this.tone(523, 0.2);
                setTimeout(() => this.tone(659, 0.2), 100);
                setTimeout(() => this.tone(784, 0.25), 200);
                setTimeout(() => this.tone(1047, 0.3), 300);
            }
        };

        // ============= 初始化场景 =============
        function initScene() {
            const w = window.innerWidth;
            const h = window.innerHeight;

            // 随机打乱句子顺序
            const shuffled = [...sentences].sort(() => Math.random() - 0.5);

            // 清空旧的句子
            el.sentenceLayer.innerHTML = '';
            state.sentenceElements = [];

            shuffled.forEach((sentence, index) => {
                // 预先计算文本尺寸
                const lines = wrapText(sentence.text, 30); // 每行最多30个字符
                const estimatedWidth = lines[0].length * 12; // 更准确的宽度估计（19px字体）
                const estimatedHeight = lines.length * 24;

                // 随机位置（避开中央排序区域和已有句子）
                let x, y;
                let attempts = 0;
                let validPosition = false;

                do {
                    x = 150 + Math.random() * (w - 300);
                    y = 100 + Math.random() * (h - 200);
                    attempts++;

                    // 检查是否在中央排序区域
                    const inCenterArea = (
                        x > w/2 - 200 && x < w/2 + 200 &&
                        y > h/2 - 200 && y < h/2 + 200
                    );

                    if (inCenterArea) continue;

                    // 检查是否与已有句子重叠（留出边距）
                    validPosition = true;
                    const margin = 80; // 句子之间的最小距离

                    for (let existing of state.sentenceElements) {
                        const dx = Math.abs(x - existing.x);
                        const dy = Math.abs(y - existing.y);
                        const minDistX = (estimatedWidth + existing.width) / 2 + margin;
                        const minDistY = (estimatedHeight + existing.height) / 2 + margin;

                        if (dx < minDistX && dy < minDistY) {
                            validPosition = false;
                            break;
                        }
                    }

                    // 如果尝试太多次，降低要求
                    if (attempts > 100) {
                        validPosition = !inCenterArea;
                    }

                } while (!validPosition && attempts < 200);

                // 创建SVG文本元素
                const textGroup = document.createElementNS('http://www.w3.org/2000/svg', 'g');
                textGroup.dataset.id = sentence.id;
                textGroup.dataset.freq = sentence.freq;

                lines.forEach((line, lineIndex) => {
                    const text = document.createElementNS('http://www.w3.org/2000/svg', 'text');
                    text.classList.add('sentence-text');
                    text.setAttribute('x', x);
                    text.setAttribute('y', y + lineIndex * 24);
                    text.textContent = line;
                    textGroup.appendChild(text);
                });

                el.sentenceLayer.appendChild(textGroup);

                state.sentenceElements.push({
                    id: sentence.id,
                    x: x,
                    y: y,
                    text: sentence.text,
                    freq: sentence.freq,
                    element: textGroup,
                    placed: false,
                    width: estimatedWidth,
                    height: estimatedHeight
                });
            });
        }

        // 文本换行辅助函数
        function wrapText(text, maxChars) {
            const words = text.split(' ');
            const lines = [];
            let currentLine = '';

            words.forEach(word => {
                if ((currentLine + word).length <= maxChars) {
                    currentLine += (currentLine ? ' ' : '') + word;
                } else {
                    if (currentLine) lines.push(currentLine);
                    currentLine = word;
                }
            });
            if (currentLine) lines.push(currentLine);

            return lines;
        }

        // ============= 拖拽处理 =============
        function startDrag(x, y) {
            if (state.completed) return;

            // 检测是否在句子区域内
            const sentence = findSentenceAtPosition(x, y);
            if (!sentence || sentence.placed) return;

            state.dragging = sentence;
            state.dragOffset = {
                x: x - sentence.x,
                y: y - sentence.y
            };

            sentence.element.classList.add('dragging');

            // 播放音调
            Audio.playTone(sentence.freq);
        }

        function onMouseDown(e) {
            startDrag(e.clientX, e.clientY);
        }

        function onTouchStart(e) {
            if (e.touches.length > 0) {
                e.preventDefault();
                const touch = e.touches[0];
                startDrag(touch.clientX, touch.clientY);
            }
        }

        function onMouseMove(e) {
            updateTouchPosition(e.clientX, e.clientY);

            if (state.dragging) {
                e.preventDefault();
                const newX = e.clientX - state.dragOffset.x;
                const newY = e.clientY - state.dragOffset.y;

                // 更新句子位置
                state.dragging.x = newX;
                state.dragging.y = newY;

                const texts = state.dragging.element.querySelectorAll('text');
                texts.forEach((text, index) => {
                    text.setAttribute('x', newX);
                    text.setAttribute('y', newY + index * 24);
                });

                checkSlotHighlight(e.clientX, e.clientY);
            }
        }

        function onTouchMove(e) {
            if (e.touches.length === 0) return;
            const touch = e.touches[0];

            updateTouchPosition(touch.clientX, touch.clientY);

            if (state.dragging) {
                e.preventDefault();
                const newX = touch.clientX - state.dragOffset.x;
                const newY = touch.clientY - state.dragOffset.y;

                // 更新句子位置
                state.dragging.x = newX;
                state.dragging.y = newY;

                const texts = state.dragging.element.querySelectorAll('text');
                texts.forEach((text, index) => {
                    text.setAttribute('x', newX);
                    text.setAttribute('y', newY + index * 24);
                });

                checkSlotHighlight(touch.clientX, touch.clientY);
            }
        }

        function endDrag(e) {
            if (!state.dragging) return;

            const clientX = e.changedTouches ? e.changedTouches[0].clientX : e.clientX;
            const clientY = e.changedTouches ? e.changedTouches[0].clientY : e.clientY;

            const slot = findSlotAtPosition(clientX, clientY);

            if (slot) {
                placeInSlot(state.dragging, slot);
            }

            state.dragging.element.classList.remove('dragging');
            state.dragging = null;

            // 移除所有高亮
            document.querySelectorAll('.sort-slot').forEach(s => s.classList.remove('highlight'));

            checkCompletion();
        }

        function checkSlotHighlight(x, y) {
            document.querySelectorAll('.sort-slot').forEach(slot => {
                slot.classList.remove('highlight');
            });

            const slot = findSlotAtPosition(x, y);
            if (slot) {
                slot.classList.add('highlight');
            }
        }

        function findSlotAtPosition(x, y) {
            const slots = document.querySelectorAll('.sort-slot');
            for (let slot of slots) {
                const line = slot.querySelector('.slot-line');
                const rect = line.getBoundingClientRect();
                // 扩大检测区域
                if (x >= rect.left - 20 && x <= rect.right + 20 &&
                    y >= rect.top - 20 && y <= rect.bottom + 20) {
                    return slot;
                }
            }
            return null;
        }

        function findSentenceAtPosition(x, y) {
            for (let sentence of state.sentenceElements) {
                if (sentence.placed) continue;

                const halfWidth = sentence.width / 2;
                const halfHeight = sentence.height / 2;

                if (x >= sentence.x - halfWidth && x <= sentence.x + halfWidth &&
                    y >= sentence.y - halfHeight && y <= sentence.y + halfHeight + 50) {
                    return sentence;
                }
            }
            return null;
        }

        function placeInSlot(sentence, slot) {
            const slotIndex = parseInt(slot.dataset.slot) - 1;

            // 如果槽位已有内容，将旧内容恢复为未放置状态
            if (state.slotContents[slotIndex]) {
                const oldSentence = state.sentenceElements.find(s => s.id === state.slotContents[slotIndex]);
                if (oldSentence) {
                    oldSentence.placed = false;
                    oldSentence.element.style.display = '';
                }
            }

            // 如果这个句子已在其他槽位，清除旧槽位
            const oldSlotIndex = state.slotContents.indexOf(sentence.id);
            if (oldSlotIndex !== -1) {
                state.slotContents[oldSlotIndex] = null;
                const oldSlot = document.querySelector(`.sort-slot[data-slot="${oldSlotIndex + 1}"]`);
                if (oldSlot) {
                    oldSlot.classList.remove('filled');
                    const oldContent = oldSlot.querySelector('.slot-content');
                    if (oldContent) oldContent.remove();
                }
            }

            // 放置句子
            state.slotContents[slotIndex] = sentence.id;
            sentence.placed = true;

            // 隐藏SVG元素
            sentence.element.style.display = 'none';

            // 更新槽位显示
            slot.classList.add('filled');
            const existingContent = slot.querySelector('.slot-content');
            if (existingContent) existingContent.remove();

            const content = document.createElement('div');
            content.className = 'slot-content';
            content.textContent = sentence.text;
            slot.querySelector('.slot-line').appendChild(content);

            // 播放音调
            Audio.playTone(sentence.freq);
        }

        function checkCompletion() {
            // 检查是否所有槽位都已填充
            if (state.slotContents.some(s => s === null)) return;

            // 检查顺序是否正确
            const correct = state.slotContents.every((id, index) => id === index + 1);

            if (correct) {
                state.completed = true;
                Audio.success();

                setTimeout(() => {
                    showEnd();
                }, 1000);
            }
        }

        // ============= 触摸位置更新 =============
        function updateTouchPosition(x, y) {
            state.mouseX = x;
            state.mouseY = y;

            // 更新触摸圈位置
            el.touchCircle.style.left = x + 'px';
            el.touchCircle.style.top = y + 'px';

            // 更新遮罩圆位置
            el.maskCircle.setAttribute('cx', x);
            el.maskCircle.setAttribute('cy', y);

            // 检测触摸的句子并播放音调
            checkTouchSound(x, y);
        }

        function checkTouchSound(x, y) {
            if (state.dragging) return;

            // 检测触摸到的句子
            for (let sentence of state.sentenceElements) {
                if (sentence.placed) continue;

                const halfWidth = sentence.width / 2;
                const halfHeight = sentence.height / 2;

                if (x >= sentence.x - halfWidth && x <= sentence.x + halfWidth &&
                    y >= sentence.y - halfHeight && y <= sentence.y + halfHeight + 50) {
                    Audio.playTone(sentence.freq);
                    break;
                }
            }
        }

        // ============= 键盘控制 =============
        function onKeyDown(e) {
            const step = 30;
            let moved = false;

            switch(e.key) {
                case 'ArrowUp':
                    state.mouseY = Math.max(60, state.mouseY - step);
                    moved = true;
                    break;
                case 'ArrowDown':
                    state.mouseY = Math.min(window.innerHeight - 60, state.mouseY + step);
                    moved = true;
                    break;
                case 'ArrowLeft':
                    state.mouseX = Math.max(60, state.mouseX - step);
                    moved = true;
                    break;
                case 'ArrowRight':
                    state.mouseX = Math.min(window.innerWidth - 60, state.mouseX + step);
                    moved = true;
                    break;
            }

            if (moved) {
                e.preventDefault();
                updateTouchPosition(state.mouseX, state.mouseY);
            }
        }

        // ============= 结束画面 =============
        function showEnd() {
            el.instruction.style.opacity = 0;
            el.endMessage.innerHTML = 'You understood the world of the blind<br><br>In darkness, touch and hearing<br>are their ways to perceive the world';
            el.endScreen.classList.add('visible');
        }

        // ============= 辅助 =============
        function toggleSound() {
            state.soundOn = !state.soundOn;
            el.soundToggle.setAttribute('aria-pressed', state.soundOn);
        }

        function announce(msg) {
            el.live.textContent = msg;
            setTimeout(() => el.live.textContent = '', 1000);
        }

        // ============= 初始化 =============
        function init() {
            Audio.init();
            initScene();

            el.scene.addEventListener('mousemove', onMouseMove);
            el.scene.addEventListener('touchmove', onTouchMove, { passive: false });
            el.scene.addEventListener('mousedown', onMouseDown);
            el.scene.addEventListener('touchstart', onTouchStart, { passive: false });
            el.scene.addEventListener('mouseup', endDrag);
            el.scene.addEventListener('touchend', endDrag);
            el.scene.addEventListener('keydown', onKeyDown);
            el.soundToggle.addEventListener('click', toggleSound);

            window.addEventListener('resize', initScene);

            updateTouchPosition(state.mouseX, state.mouseY);
        }

        // ============= 启动 =============
        init();
    </script>
</body>
</html>
