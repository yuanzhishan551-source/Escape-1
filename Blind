<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>The World of the Blind</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Abhaya+Libre:wght@400;500;600;700&display=swap" rel="stylesheet">
    <!-- MediaPipe Hands -->
    <script src="https://cdn.jsdelivr.net/npm/@mediapipe/hands/hands.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/@mediapipe/camera_utils/camera_utils.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/@mediapipe/drawing_utils/drawing_utils.js" crossorigin="anonymous"></script>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Abhaya Libre', 'Segoe UI', system-ui, serif;
            background: #000;
            color: #666;
            overflow: hidden;
            cursor: none;
        }

        /* 页面容器 */
        .pages-container {
            width: 100vw;
            height: 100vh;
            overflow-y: hidden;
            scroll-snap-type: y mandatory;
            scroll-behavior: smooth;
        }

        /* 单个页面 */
        .page {
            width: 100vw;
            height: 100vh;
            position: relative;
            background: #000;
            scroll-snap-align: start;
            padding: 80px 100px;
        }

        /* 页面内容容器 */
        .page-content {
            width: 100%;
            height: 100%;
            position: relative;
        }

        /* 左对齐（奇数页）*/
        .page.align-left .initial-text-container {
            text-align: left;
            padding-left: 50px;
        }

        /* 右对齐（偶数页）*/
        .page.align-right .initial-text-container {
            text-align: right;
            padding-right: 50px;
        }

        /* 初始文字容器 */
        .initial-text-container {
            position: relative;
            z-index: 10;
        }

        /* 初始文字 */
        .initial-text {
            font-size: 28px;
            color: rgba(220, 220, 220, 0.9);
            margin-bottom: 40px;
            opacity: 0;
            transform: translateY(20px);
            transition: all 0.8s ease;
        }

        .initial-text.visible {
            opacity: 1;
            transform: translateY(0);
        }

        .initial-text.blurred {
            filter: blur(3px);
            opacity: 0.5;
        }

        /* 空槽位线 */
        .slot-line-inline {
            display: inline-block;
            width: 200px;
            height: 1px;
            background: rgba(180, 180, 180, 0.6);
            vertical-align: middle;
            position: relative;
            margin: 0 10px;
        }

        .slot-line-inline.filled {
            background: none;
        }

        .slot-line-inline .filled-text {
            position: absolute;
            top: -20px;
            left: 0;
            width: 100%;
            text-align: center;
            font-size: 28px;
            color: rgba(120, 120, 120, 0.8);
            white-space: nowrap;
        }

        /* SVG 场景层 - 选项文字 */
        .scene-svg {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 5;
        }

        /* 句子文本 - 使用遮罩只显示触摸圈内的部分 */
        .sentence-text {
            fill: rgba(220, 220, 220, 0.9);
            font-size: 28px;
            font-family: 'Abhaya Libre', 'Segoe UI', system-ui, serif;
            cursor: grab;
            user-select: none;
            pointer-events: all;
        }

        .sentence-text.dragging {
            cursor: grabbing;
        }

        /* 触摸圈 */
        .touch-circle {
            position: fixed;
            width: 8px;
            height: 8px;
            pointer-events: none;
            transform: translate(-50%, -50%);
            z-index: 100;
        }

        .touch-circle::after {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            width: 3px;
            height: 3px;
            background: rgba(200, 200, 200, 0.5);
            border-radius: 50%;
            transform: translate(-50%, -50%);
            box-shadow: 0 0 8px rgba(200, 200, 200, 0.4);
        }

        /* 手部骨架画布 */
        #handCanvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 10;
        }

        #handCanvas.hint-mode {
            opacity: 0.3;
        }

        #handCanvas.tracking-mode {
            opacity: 0.8;
        }

        /* 手部指示点 */
        .finger-pointer {
            position: fixed;
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background: rgba(200, 200, 200, 0.7);
            border: 2px solid rgba(220, 220, 220, 0.9);
            pointer-events: none;
            transform: translate(-50%, -50%);
            z-index: 150;
            box-shadow: 0 0 10px rgba(200, 200, 200, 0.6);
            transition: all 0.05s ease;
        }

        .finger-pointer.pinching {
            background: rgba(255, 180, 120, 0.8);
            border-color: rgba(255, 200, 150, 0.9);
            box-shadow: 0 0 15px rgba(255, 180, 120, 0.7);
            width: 16px;
            height: 16px;
        }

        /* 摄像头视频 - 隐藏 */
        #video {
            position: absolute;
            top: 0;
            left: 0;
            width: 1px;
            height: 1px;
            opacity: 0;
            pointer-events: none;
        }

        /* 声音开关 */
        .sound-toggle {
            position: fixed;
            top: 20px;
            right: 20px;
            background: none;
            border: 1px solid rgba(100, 100, 100, 0.3);
            color: rgba(150, 150, 150, 0.6);
            padding: 8px 12px;
            border-radius: 4px;
            cursor: pointer;
            font-size: 0.75rem;
            transition: all 0.2s;
            z-index: 1000;
        }

        .sound-toggle:hover,
        .sound-toggle:focus {
            border-color: rgba(150, 150, 150, 0.5);
            color: rgba(180, 180, 180, 0.8);
            outline: none;
        }

        /* 结束画面 */
        .end-screen {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.95);
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            transition: opacity 1s;
            pointer-events: none;
            z-index: 200;
        }

        .end-screen.visible {
            opacity: 1;
            pointer-events: all;
        }

        .end-message {
            text-align: center;
            color: rgba(220, 220, 220, 0.9);
            font-size: 1.4rem;
            line-height: 2.2;
            max-width: 600px;
            padding: 40px;
            font-weight: 300;
        }

        @media (max-width: 768px) {
            .page {
                padding: 60px 40px;
            }
            .initial-text {
                font-size: 24px;
            }
            .sentence-text {
                font-size: 24px;
            }
        }
    </style>
</head>
<body>
    <!-- 页面容器 -->
    <div class="pages-container" id="pagesContainer">
        <!-- 页面1: 导航场景 -->
        <div class="page align-left" id="page1" data-page="1">
            <div class="page-content">
                <div class="initial-text-container" id="initialText1">
                    <!-- 初始文字将通过JavaScript动态添加 -->
                </div>
                <!-- SVG层用于选项文字 -->
                <svg class="scene-svg" id="sceneSvg1">
                    <defs>
                        <radialGradient id="touchGradient1">
                            <stop offset="0%" stop-color="white" stop-opacity="1"/>
                            <stop offset="50%" stop-color="white" stop-opacity="0.8"/>
                            <stop offset="80%" stop-color="white" stop-opacity="0.3"/>
                            <stop offset="100%" stop-color="white" stop-opacity="0"/>
                        </radialGradient>
                        <mask id="touchMask1">
                            <rect width="100%" height="100%" fill="black"/>
                            <circle id="maskCircle1" r="80" fill="url(#touchGradient1)"/>
                        </mask>
                    </defs>
                    <g id="sentenceLayer1" mask="url(#touchMask1)"></g>
                </svg>
            </div>
        </div>

        <!-- 页面2: 第二个场景 -->
        <div class="page align-right" id="page2" data-page="2">
            <div class="page-content">
                <div class="initial-text-container" id="initialText2">
                    <!-- 页面2内容 -->
                </div>
                <svg class="scene-svg" id="sceneSvg2">
                    <defs>
                        <radialGradient id="touchGradient2">
                            <stop offset="0%" stop-color="white" stop-opacity="1"/>
                            <stop offset="50%" stop-color="white" stop-opacity="0.8"/>
                            <stop offset="80%" stop-color="white" stop-opacity="0.3"/>
                            <stop offset="100%" stop-color="white" stop-opacity="0"/>
                        </radialGradient>
                        <mask id="touchMask2">
                            <rect width="100%" height="100%" fill="black"/>
                            <circle id="maskCircle2" r="80" fill="url(#touchGradient2)"/>
                        </mask>
                    </defs>
                    <g id="sentenceLayer2" mask="url(#touchMask2)"></g>
                </svg>
            </div>
        </div>

        <!-- 页面3: 第三个场景 -->
        <div class="page align-left" id="page3" data-page="3">
            <div class="page-content">
                <div class="initial-text-container" id="initialText3">
                    <!-- 页面3内容 -->
                </div>
                <svg class="scene-svg" id="sceneSvg3">
                    <defs>
                        <radialGradient id="touchGradient3">
                            <stop offset="0%" stop-color="white" stop-opacity="1"/>
                            <stop offset="50%" stop-color="white" stop-opacity="0.8"/>
                            <stop offset="80%" stop-color="white" stop-opacity="0.3"/>
                            <stop offset="100%" stop-color="white" stop-opacity="0"/>
                        </radialGradient>
                        <mask id="touchMask3">
                            <rect width="100%" height="100%" fill="black"/>
                            <circle id="maskCircle3" r="80" fill="url(#touchGradient3)"/>
                        </mask>
                    </defs>
                    <g id="sentenceLayer3" mask="url(#touchMask3)"></g>
                </svg>
            </div>
        </div>
    </div>

    <!-- 触摸圈 -->
    <div class="touch-circle" id="touchCircle"></div>

    <!-- 手部骨架画布 -->
    <canvas id="handCanvas" class="hint-mode"></canvas>

    <!-- 摄像头视频（隐藏） -->
    <video id="video" autoplay playsinline></video>

    <!-- 声音开关 -->
    <button class="sound-toggle" id="soundToggle" aria-pressed="true">Sound</button>

    <!-- 手部指示点 -->
    <div class="finger-pointer" id="thumbPointer" style="display: none;"></div>
    <div class="finger-pointer" id="indexPointer" style="display: none;"></div>

    <!-- 结束画面 -->
    <div class="end-screen" id="endScreen">
        <div class="end-message" id="endMessage"></div>
    </div>

    <script>
        // ============= 页面数据 =============
        const pagesData = [
            // 页面1: 导航场景
            {
                id: 1,
                initialTexts: [
                    { text: 'You are Your Way Home.', tone: 'do', freq: 261.63 },
                    { text: 'At the next intersection, you should:', tone: 're', freq: 293.66 },
                    { text: '__SLOT__', tone: 'mi', freq: 329.63, slotId: 'slot1' },
                    { text: 'Based on the sound, you are safely crossed this intersection.', tone: 'fa', freq: 349.23, showAfterSlot: 'slot1' }
                ],
                optionTexts: [
                    { text: 'Go straight.', correctSlot: null, freq: 261.63 },  // do (wrong)
                    { text: 'Turn Left.', correctSlot: 'slot1', freq: 329.63 },  // mi (correct)
                    { text: 'Turn Right.', correctSlot: null, freq: 349.23 }  // fa (wrong)
                ]
            },
            // 页面2: 购物场景
            {
                id: 2,
                initialTexts: [
                    { text: 'You are at the supermarket.', tone: 'sol', freq: 392.00 },
                    { text: 'You need to find:', tone: 'la', freq: 440.00 },
                    { text: '__SLOT__', tone: 'do', freq: 523.26, slotId: 'slot2' },
                    { text: 'You successfully found the item by its sound.', tone: 're', freq: 587.33, showAfterSlot: 'slot2' }
                ],
                optionTexts: [
                    { text: 'The milk section.', correctSlot: 'slot2', freq: 329.63 },  // mi (correct)
                    { text: 'The bread aisle.', correctSlot: null, freq: 261.63 },  // do (wrong)
                    { text: 'The checkout counter.', correctSlot: null, freq: 349.23 }  // fa (wrong)
                ]
            },
            // 页面3: 回家场景
            {
                id: 3,
                initialTexts: [
                    { text: 'You arrive at your building.', tone: 'mi', freq: 659.25 },
                    { text: 'To enter, you should:', tone: 'fa', freq: 698.46 },
                    { text: '__SLOT__', tone: 'sol', freq: 783.99, slotId: 'slot3' },
                    { text: 'You made it home safely. Welcome home.', tone: 'la', freq: 880.00, showAfterSlot: 'slot3' }
                ],
                optionTexts: [
                    { text: 'Wait for someone.', correctSlot: null, freq: 261.63 },  // do (wrong)
                    { text: 'Use your key card.', correctSlot: 'slot3', freq: 329.63 },  // mi (correct)
                    { text: 'Ring the doorbell.', correctSlot: null, freq: 349.23 }  // fa (wrong)
                ]
            }
        ];

        // ============= 状态 =============
        const state = {
            soundOn: true,
            currentPage: 1,
            mouseX: window.innerWidth / 2,
            mouseY: window.innerHeight / 2,
            dragging: null,
            dragOffset: { x: 0, y: 0 },
            // 手势识别相关
            handDetected: false,
            isPinching: false,
            pinchPoint: { x: 0, y: 0 },
            lastPinchState: false,
            pinchStableFrames: 0,
            currentTouchedOption: null,  // 当前触摸的选项
            // 页面状态
            pageStates: {
                1: { textIndex: 0, slotsFilled: {}, completed: false, optionElements: [] },
                2: { textIndex: 0, slotsFilled: {}, completed: false, optionElements: [] },
                3: { textIndex: 0, slotsFilled: {}, completed: false, optionElements: [] }
            }
        };

        // ============= DOM =============
        const el = {
            pagesContainer: document.getElementById('pagesContainer'),
            touchCircle: document.getElementById('touchCircle'),
            soundToggle: document.getElementById('soundToggle'),
            endScreen: document.getElementById('endScreen'),
            endMessage: document.getElementById('endMessage'),
            video: document.getElementById('video'),
            handCanvas: document.getElementById('handCanvas'),
            thumbPointer: document.getElementById('thumbPointer'),
            indexPointer: document.getElementById('indexPointer')
        };

        // 初始化画布
        const canvasCtx = el.handCanvas.getContext('2d');
        el.handCanvas.width = window.innerWidth;
        el.handCanvas.height = window.innerHeight;

        // ============= 音频 - MP3 音效 =============
        const Audio = {
            sounds: {},
            soundMap: {
                261.63: '1.C(do).mp3',
                293.66: '2.D(re).mp3',
                329.63: '3.E(mi).mp3',
                349.23: '4.F(fa).mp3',
                392.00: '5.G(sol).mp3',
                440.00: '6.A(la).mp3',
                523.26: '1.C(do).mp3',
                587.33: '2.D(re).mp3',
                659.25: '3.E(mi).mp3',
                698.46: '4.F(fa).mp3',
                783.99: '5.G(sol).mp3',
                880.00: '6.A(la).mp3'
            },
            init() {
                this.preloadSounds();
            },
            preloadSounds() {
                const files = [
                    '1.C(do).mp3',
                    '2.D(re).mp3',
                    '3.E(mi).mp3',
                    '4.F(fa).mp3',
                    '5.G(sol).mp3',
                    '6.A(la).mp3'
                ];

                files.forEach(file => {
                    const audio = document.createElement('audio');
                    audio.src = file;
                    audio.preload = 'auto';
                    this.sounds[file] = audio;
                });
            },
            playTone(freq) {
                if (!state.soundOn) return;

                const filename = this.soundMap[freq];
                if (!filename) {
                    console.warn('未找到频率对应的音频:', freq);
                    return;
                }

                const audio = this.sounds[filename];
                if (audio) {
                    const clone = audio.cloneNode();
                    clone.volume = 0.5;
                    clone.play().catch(e => console.error('播放音频失败:', e));
                } else {
                    console.warn('音频文件未加载:', filename);
                }
            },
            success() {
                this.playTone(523.26);
                setTimeout(() => this.playTone(659.25), 150);
                setTimeout(() => this.playTone(783.99), 300);
                setTimeout(() => this.playTone(1046.50), 450);
            }
        };

        // ============= 手势识别系统 =============
        let hands, camera;

        const HAND_CONNECTIONS = [
            [0, 1], [1, 2], [2, 3], [3, 4],
            [0, 5], [5, 6], [6, 7], [7, 8],
            [0, 9], [9, 10], [10, 11], [11, 12],
            [0, 13], [13, 14], [14, 15], [15, 16],
            [0, 17], [17, 18], [18, 19], [19, 20],
            [5, 9], [9, 13], [13, 17]
        ];

        function drawHand(landmarks, mirrored = true) {
            canvasCtx.clearRect(0, 0, el.handCanvas.width, el.handCanvas.height);

            if (!landmarks) return;

            canvasCtx.strokeStyle = 'rgba(200, 200, 200, 0.7)';
            canvasCtx.lineWidth = 2;
            canvasCtx.lineCap = 'round';

            HAND_CONNECTIONS.forEach(([start, end]) => {
                const startPoint = landmarks[start];
                const endPoint = landmarks[end];

                const startX = mirrored ? (1 - startPoint.x) * el.handCanvas.width : startPoint.x * el.handCanvas.width;
                const startY = startPoint.y * el.handCanvas.height;
                const endX = mirrored ? (1 - endPoint.x) * el.handCanvas.width : endPoint.x * el.handCanvas.width;
                const endY = endPoint.y * el.handCanvas.height;

                canvasCtx.beginPath();
                canvasCtx.moveTo(startX, startY);
                canvasCtx.lineTo(endX, endY);
                canvasCtx.stroke();
            });

            canvasCtx.fillStyle = 'rgba(220, 220, 220, 0.8)';
            landmarks.forEach((point) => {
                const x = mirrored ? (1 - point.x) * el.handCanvas.width : point.x * el.handCanvas.width;
                const y = point.y * el.handCanvas.height;

                canvasCtx.beginPath();
                canvasCtx.arc(x, y, 4, 0, 2 * Math.PI);
                canvasCtx.fill();
            });
        }

        function drawHintHand() {
            const centerX = 0.75;
            const centerY = 0.5;
            const scale = 0.375;

            const hintPose = [
                { x: centerX, y: centerY + 0.05 * scale },
                { x: centerX - 0.03 * scale, y: centerY + 0.03 * scale },
                { x: centerX - 0.05 * scale, y: centerY - 0.02 * scale },
                { x: centerX - 0.06 * scale, y: centerY - 0.08 * scale },
                { x: centerX - 0.07 * scale, y: centerY - 0.14 * scale },
                { x: centerX - 0.01 * scale, y: centerY },
                { x: centerX - 0.01 * scale, y: centerY - 0.10 * scale },
                { x: centerX - 0.01 * scale, y: centerY - 0.20 * scale },
                { x: centerX - 0.01 * scale, y: centerY - 0.30 * scale },
                { x: centerX + 0.01 * scale, y: centerY },
                { x: centerX + 0.01 * scale, y: centerY - 0.11 * scale },
                { x: centerX + 0.01 * scale, y: centerY - 0.22 * scale },
                { x: centerX + 0.01 * scale, y: centerY - 0.33 * scale },
                { x: centerX + 0.03 * scale, y: centerY },
                { x: centerX + 0.03 * scale, y: centerY - 0.10 * scale },
                { x: centerX + 0.03 * scale, y: centerY - 0.20 * scale },
                { x: centerX + 0.03 * scale, y: centerY - 0.29 * scale },
                { x: centerX + 0.05 * scale, y: centerY + 0.01 * scale },
                { x: centerX + 0.05 * scale, y: centerY - 0.08 * scale },
                { x: centerX + 0.05 * scale, y: centerY - 0.17 * scale },
                { x: centerX + 0.05 * scale, y: centerY - 0.25 * scale }
            ];

            drawHand(hintPose, false);
        }

        function initHandTracking() {
            hands = new Hands({
                locateFile: (file) => {
                    return `https://cdn.jsdelivr.net/npm/@mediapipe/hands/${file}`;
                }
            });

            hands.setOptions({
                maxNumHands: 1,
                modelComplexity: 1,
                minDetectionConfidence: 0.5,
                minTrackingConfidence: 0.5
            });

            hands.onResults(onHandResults);

            camera = new Camera(el.video, {
                onFrame: async () => {
                    await hands.send({ image: el.video });
                },
                width: 1280,
                height: 720
            });

            camera.start();
        }

        function onHandResults(results) {
            if (results.multiHandLandmarks && results.multiHandLandmarks.length > 0) {
                const landmarks = results.multiHandLandmarks[0];

                drawHand(landmarks, true);

                if (!state.handDetected) {
                    state.handDetected = true;
                    el.handCanvas.classList.remove('hint-mode');
                    el.handCanvas.classList.add('tracking-mode');
                }

                const thumbTip = landmarks[4];
                const indexTip = landmarks[8];

                const thumbX = (1 - thumbTip.x) * window.innerWidth;
                const thumbY = thumbTip.y * window.innerHeight;
                const indexX = (1 - indexTip.x) * window.innerWidth;
                const indexY = indexTip.y * window.innerHeight;

                const pinchX = (thumbX + indexX) / 2;
                const pinchY = (thumbY + indexY) / 2;

                const distance = Math.sqrt(
                    Math.pow(thumbX - indexX, 2) +
                    Math.pow(thumbY - indexY, 2)
                );

                const isPinchingRaw = distance < 60;

                let isPinching = isPinchingRaw;
                if (isPinchingRaw) {
                    state.pinchStableFrames++;
                    if (state.pinchStableFrames < 2) {
                        isPinching = state.lastPinchState;
                    }
                } else {
                    state.pinchStableFrames = 0;
                }

                el.thumbPointer.style.display = 'block';
                el.thumbPointer.style.left = thumbX + 'px';
                el.thumbPointer.style.top = thumbY + 'px';

                el.indexPointer.style.display = 'block';
                el.indexPointer.style.left = indexX + 'px';
                el.indexPointer.style.top = indexY + 'px';

                if (isPinching) {
                    el.thumbPointer.classList.add('pinching');
                    el.indexPointer.classList.add('pinching');
                } else {
                    el.thumbPointer.classList.remove('pinching');
                    el.indexPointer.classList.remove('pinching');
                }

                updateTouchPosition(indexX, indexY);

                if (isPinching && !state.lastPinchState) {
                    handlePinchStart(pinchX, pinchY);
                } else if (isPinching && state.lastPinchState) {
                    handlePinchMove(pinchX, pinchY);
                } else if (!isPinching && state.lastPinchState) {
                    handlePinchEnd(pinchX, pinchY);
                }

                state.lastPinchState = isPinching;
                state.isPinching = isPinching;
                state.pinchPoint = { x: pinchX, y: pinchY };

            } else {
                if (state.handDetected) {
                    el.thumbPointer.style.display = 'none';
                    el.indexPointer.style.display = 'none';
                    if (state.dragging) {
                        endDrag({ clientX: state.pinchPoint.x, clientY: state.pinchPoint.y });
                    }
                    el.handCanvas.classList.remove('tracking-mode');
                    el.handCanvas.classList.add('hint-mode');
                    drawHintHand();
                }
                state.handDetected = false;
                state.lastPinchState = false;
                state.pinchStableFrames = 0;
            }
        }

        function handlePinchStart(x, y) {
            const option = findOptionAtPosition(x, y);
            if (option) {
                startDrag(x, y);
            }
        }

        function handlePinchMove(x, y) {
            if (!state.dragging) return;

            // 转换viewport坐标到SVG坐标
            const currentSvg = document.getElementById(`sceneSvg${state.currentPage}`);
            if (!currentSvg) return;

            const svgRect = currentSvg.getBoundingClientRect();
            const svgX = x - svgRect.left;
            const svgY = y - svgRect.top;

            const newX = svgX - state.dragOffset.x;
            const newY = svgY - state.dragOffset.y;

            state.dragging.x = newX;
            state.dragging.y = newY;

            const texts = state.dragging.element.querySelectorAll('text');
            texts.forEach((text, index) => {
                text.setAttribute('x', newX);
                text.setAttribute('y', newY + index * 36);
            });
        }

        function handlePinchEnd(x, y) {
            if (!state.dragging) return;

            const slotId = findSlotAtPosition(x, y);

            if (slotId) {
                placeInSlot(state.dragging, slotId);
            }

            state.dragging.element.classList.remove('dragging');
            state.dragging = null;
        }

        // ============= 初始化页面内容 =============
        function initPage(pageNum) {
            const pageData = pagesData[pageNum - 1];
            const pageState = state.pageStates[pageNum];

            // 开始显示初始文字序列
            showNextInitialText(pageNum);
        }

        function showNextInitialText(pageNum) {
            const pageData = pagesData[pageNum - 1];
            const pageState = state.pageStates[pageNum];
            const container = document.getElementById(`initialText${pageNum}`);

            if (pageState.textIndex >= pageData.initialTexts.length) {
                // 所有初始文字已显示，现在显示选项文字
                initOptionTexts(pageNum);
                return;
            }

            const textData = pageData.initialTexts[pageState.textIndex];

            // 检查是否需要等待槽位填充
            if (textData.showAfterSlot) {
                // 这个文本需要等待槽位填充后才显示，跳过它继续下一个
                pageState.textIndex++;
                showNextInitialText(pageNum);
                return;
            }

            if (textData.text === '__SLOT__') {
                // 创建槽位线
                const slotDiv = document.createElement('div');
                slotDiv.className = 'initial-text visible';
                slotDiv.innerHTML = `<span class="slot-line-inline" data-slot="${textData.slotId}"></span>`;
                container.appendChild(slotDiv);

                // 播放音调
                Audio.playTone(textData.freq);

                // 继续下一个
                pageState.textIndex++;
                setTimeout(() => showNextInitialText(pageNum), 1000);
            } else {
                // 创建普通文本
                const textDiv = document.createElement('div');
                textDiv.className = 'initial-text';
                textDiv.textContent = textData.text;
                container.appendChild(textDiv);

                // 显示文本
                setTimeout(() => {
                    textDiv.classList.add('visible');

                    // 播放音调
                    Audio.playTone(textData.freq);

                    // 模糊文本
                    setTimeout(() => {
                        textDiv.classList.add('blurred');

                        // 继续下一个
                        pageState.textIndex++;
                        showNextInitialText(pageNum);
                    }, 1000);
                }, 100);
            }
        }

        function initOptionTexts(pageNum) {
            const pageData = pagesData[pageNum - 1];
            const pageState = state.pageStates[pageNum];
            const svgLayer = document.getElementById(`sentenceLayer${pageNum}`);
            const page = document.getElementById(`page${pageNum}`);
            const rect = page.getBoundingClientRect();

            // 随机打乱选项
            const shuffled = [...pageData.optionTexts].sort(() => Math.random() - 0.5);

            shuffled.forEach((option, index) => {
                // 随机位置
                let x, y;
                let attempts = 0;
                let validPosition = false;

                do {
                    // SVG坐标相对于page，不需要加rect.left/top
                    x = 150 + Math.random() * (rect.width - 300);
                    y = 200 + Math.random() * (rect.height - 400);
                    attempts++;

                    // 检查是否与已有选项重叠
                    validPosition = true;
                    const margin = 200;

                    for (let existing of pageState.optionElements) {
                        const dx = Math.abs(x - existing.x);
                        const dy = Math.abs(y - existing.y);

                        if (dx < margin && dy < margin) {
                            validPosition = false;
                            break;
                        }
                    }

                } while (!validPosition && attempts < 100);

                // 创建SVG文本
                const textGroup = document.createElementNS('http://www.w3.org/2000/svg', 'g');
                textGroup.dataset.correctSlot = option.correctSlot || '';

                const text = document.createElementNS('http://www.w3.org/2000/svg', 'text');
                text.classList.add('sentence-text');
                text.setAttribute('x', x);
                text.setAttribute('y', y);
                text.textContent = option.text;
                textGroup.appendChild(text);

                svgLayer.appendChild(textGroup);

                pageState.optionElements.push({
                    text: option.text,
                    correctSlot: option.correctSlot,
                    freq: option.freq,  // 添加频率
                    x: x,
                    y: y,
                    element: textGroup,
                    placed: false
                });
            });
        }

        // ============= 拖拽处理 =============
        function startDrag(x, y) {
            const option = findOptionAtPosition(x, y);
            if (!option || option.placed) return;

            // 转换viewport坐标到SVG坐标
            const currentSvg = document.getElementById(`sceneSvg${state.currentPage}`);
            if (!currentSvg) return;

            const svgRect = currentSvg.getBoundingClientRect();
            const svgX = x - svgRect.left;
            const svgY = y - svgRect.top;

            state.dragging = option;
            state.dragOffset = {
                x: svgX - option.x,
                y: svgY - option.y
            };

            option.element.classList.add('dragging');
        }

        function endDrag(e) {
            if (!state.dragging) return;

            const clientX = e.changedTouches ? e.changedTouches[0].clientX : e.clientX;
            const clientY = e.changedTouches ? e.changedTouches[0].clientY : e.clientY;

            const slotId = findSlotAtPosition(clientX, clientY);

            if (slotId) {
                placeInSlot(state.dragging, slotId);
            }

            state.dragging.element.classList.remove('dragging');
            state.dragging = null;
        }

        function findSlotAtPosition(x, y) {
            const slots = document.querySelectorAll('.slot-line-inline');
            for (let slot of slots) {
                const rect = slot.getBoundingClientRect();
                if (x >= rect.left - 20 && x <= rect.right + 20 &&
                    y >= rect.top - 20 && y <= rect.bottom + 20) {
                    return slot.dataset.slot;
                }
            }
            return null;
        }

        function findOptionAtPosition(x, y) {
            const pageState = state.pageStates[state.currentPage];

            // 转换viewport坐标到SVG坐标
            const currentSvg = document.getElementById(`sceneSvg${state.currentPage}`);
            if (!currentSvg) return null;

            const svgRect = currentSvg.getBoundingClientRect();
            const svgX = x - svgRect.left;
            const svgY = y - svgRect.top;

            for (let option of pageState.optionElements) {
                if (option.placed) continue;

                const estimatedWidth = option.text.length * 18;
                const estimatedHeight = 36;

                if (svgX >= option.x - estimatedWidth/2 && svgX <= option.x + estimatedWidth/2 &&
                    svgY >= option.y - estimatedHeight/2 && svgY <= option.y + estimatedHeight/2) {
                    return option;
                }
            }
            return null;
        }

        function placeInSlot(option, slotId) {
            const pageState = state.pageStates[state.currentPage];
            const pageData = pagesData[state.currentPage - 1];

            // 检查是否正确
            if (option.correctSlot !== slotId) {
                // 错误，不放置
                return;
            }

            // 正确，放置
            option.placed = true;
            option.element.style.display = 'none';

            // 填充槽位
            const slotElement = document.querySelector(`.slot-line-inline[data-slot="${slotId}"]`);
            if (slotElement) {
                slotElement.classList.add('filled');

                const filledText = document.createElement('div');
                filledText.className = 'filled-text';
                filledText.textContent = option.text;
                slotElement.appendChild(filledText);
            }

            pageState.slotsFilled[slotId] = true;

            // 检查是否有需要显示的后续文本
            const nextText = pageData.initialTexts.find(t => t.showAfterSlot === slotId);
            if (nextText) {
                const container = document.getElementById(`initialText${state.currentPage}`);

                const textDiv = document.createElement('div');
                textDiv.className = 'initial-text';
                textDiv.textContent = nextText.text;
                container.appendChild(textDiv);

                setTimeout(() => {
                    textDiv.classList.add('visible');
                    Audio.playTone(nextText.freq);

                    setTimeout(() => {
                        textDiv.classList.add('blurred');
                        checkPageCompletion();
                    }, 1000);
                }, 500);
            } else {
                checkPageCompletion();
            }
        }

        function checkPageCompletion() {
            const pageState = state.pageStates[state.currentPage];
            const pageData = pagesData[state.currentPage - 1];

            // 检查所有槽位是否已填充
            const allSlotsFilled = pageData.initialTexts
                .filter(t => t.slotId)
                .every(t => pageState.slotsFilled[t.slotId]);

            if (allSlotsFilled && !pageState.completed) {
                pageState.completed = true;

                // 播放成功音效
                Audio.success();

                // 等待后自动滚动到下一页
                setTimeout(() => {
                    if (state.currentPage < 3) {
                        scrollToPage(state.currentPage + 1);
                    } else {
                        // 所有页面完成，显示结束画面
                        showEnd();
                    }
                }, 2000);
            }
        }

        function scrollToPage(pageNum) {
            const page = document.getElementById(`page${pageNum}`);
            if (page) {
                page.scrollIntoView({ behavior: 'smooth' });
                state.currentPage = pageNum;

                // 初始化新页面
                setTimeout(() => {
                    initPage(pageNum);
                }, 800);
            }
        }

        // ============= 触摸位置更新 =============
        function updateTouchPosition(x, y) {
            state.mouseX = x;
            state.mouseY = y;

            el.touchCircle.style.left = x + 'px';
            el.touchCircle.style.top = y + 'px';

            // 更新当前页面的遮罩圆位置（转换为SVG坐标）
            const currentSvg = document.getElementById(`sceneSvg${state.currentPage}`);
            const maskCircle = document.getElementById(`maskCircle${state.currentPage}`);

            if (currentSvg && maskCircle) {
                const svgRect = currentSvg.getBoundingClientRect();
                const svgX = x - svgRect.left;
                const svgY = y - svgRect.top;

                maskCircle.setAttribute('cx', svgX);
                maskCircle.setAttribute('cy', svgY);
            }

            // 检测触摸的选项文本并播放音调
            checkOptionTouch(x, y);
        }

        function checkOptionTouch(x, y) {
            if (state.dragging || state.isPinching) return;

            let touchedOption = null;
            const pageState = state.pageStates[state.currentPage];

            // 转换viewport坐标到SVG坐标
            const currentSvg = document.getElementById(`sceneSvg${state.currentPage}`);
            if (!currentSvg) return;

            const svgRect = currentSvg.getBoundingClientRect();
            const svgX = x - svgRect.left;
            const svgY = y - svgRect.top;

            // 检测触摸到的选项
            for (let option of pageState.optionElements) {
                if (option.placed) continue;

                const estimatedWidth = option.text.length * 18;
                const estimatedHeight = 36;

                if (svgX >= option.x - estimatedWidth/2 && svgX <= option.x + estimatedWidth/2 &&
                    svgY >= option.y - estimatedHeight/2 && svgY <= option.y + estimatedHeight/2) {
                    touchedOption = option;
                    break;
                }
            }

            // 只有当触摸到新选项时才播放音效
            if (touchedOption && touchedOption !== state.currentTouchedOption) {
                Audio.playTone(touchedOption.freq);
                state.currentTouchedOption = touchedOption;
            } else if (!touchedOption) {
                // 离开所有选项时，重置
                state.currentTouchedOption = null;
            }
        }

        // ============= 鼠标/触摸事件 =============
        function onMouseMove(e) {
            updateTouchPosition(e.clientX, e.clientY);

            if (state.dragging) {
                e.preventDefault();

                // 转换viewport坐标到SVG坐标
                const currentSvg = document.getElementById(`sceneSvg${state.currentPage}`);
                if (!currentSvg) return;

                const svgRect = currentSvg.getBoundingClientRect();
                const svgX = e.clientX - svgRect.left;
                const svgY = e.clientY - svgRect.top;

                const newX = svgX - state.dragOffset.x;
                const newY = svgY - state.dragOffset.y;

                state.dragging.x = newX;
                state.dragging.y = newY;

                const texts = state.dragging.element.querySelectorAll('text');
                texts.forEach((text, index) => {
                    text.setAttribute('x', newX);
                    text.setAttribute('y', newY + index * 36);
                });
            }
        }

        function onMouseDown(e) {
            startDrag(e.clientX, e.clientY);
        }

        function onTouchMove(e) {
            if (e.touches.length === 0) return;
            const touch = e.touches[0];

            updateTouchPosition(touch.clientX, touch.clientY);

            if (state.dragging) {
                e.preventDefault();

                // 转换viewport坐标到SVG坐标
                const currentSvg = document.getElementById(`sceneSvg${state.currentPage}`);
                if (!currentSvg) return;

                const svgRect = currentSvg.getBoundingClientRect();
                const svgX = touch.clientX - svgRect.left;
                const svgY = touch.clientY - svgRect.top;

                const newX = svgX - state.dragOffset.x;
                const newY = svgY - state.dragOffset.y;

                state.dragging.x = newX;
                state.dragging.y = newY;

                const texts = state.dragging.element.querySelectorAll('text');
                texts.forEach((text, index) => {
                    text.setAttribute('x', newX);
                    text.setAttribute('y', newY + index * 36);
                });
            }
        }

        function onTouchStart(e) {
            if (e.touches.length > 0) {
                e.preventDefault();
                const touch = e.touches[0];
                startDrag(touch.clientX, touch.clientY);
            }
        }

        // ============= 结束画面 =============
        function showEnd() {
            el.endMessage.innerHTML = 'You understood the world of the blind<br><br>In darkness, touch and hearing<br>are their ways to perceive the world';
            el.endScreen.classList.add('visible');
        }

        // ============= 辅助 =============
        function toggleSound() {
            state.soundOn = !state.soundOn;
            el.soundToggle.setAttribute('aria-pressed', state.soundOn);
        }

        // ============= 初始化 =============
        function init() {
            Audio.init();

            // 绘制初始提示手部骨架
            drawHintHand();

            // 初始化手势识别
            initHandTracking();

            // 初始化第一页
            initPage(1);

            // 事件监听
            document.addEventListener('mousemove', onMouseMove);
            document.addEventListener('touchmove', onTouchMove, { passive: false });
            document.addEventListener('mousedown', onMouseDown);
            document.addEventListener('touchstart', onTouchStart, { passive: false });
            document.addEventListener('mouseup', endDrag);
            document.addEventListener('touchend', endDrag);
            el.soundToggle.addEventListener('click', toggleSound);

            window.addEventListener('resize', () => {
                el.handCanvas.width = window.innerWidth;
                el.handCanvas.height = window.innerHeight;
                if (!state.handDetected) {
                    drawHintHand();
                }
            });

            updateTouchPosition(state.mouseX, state.mouseY);
        }

        // ============= 启动 =============
        init();
    </script>
</body>
</html>
