<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>盲人的世界</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', 'Microsoft YaHei', system-ui, sans-serif;
            background: #000;
            color: #666;
            min-height: 100vh;
            overflow: hidden;
            cursor: none;
        }

        /* 场景容器 */
        .scene {
            width: 100vw;
            height: 100vh;
            position: relative;
            background: #000;
        }

        /* SVG 场景层 */
        .scene-svg {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
        }

        /* 物体轮廓 - 使用遮罩只显示触摸圈内的部分 */
        .outline {
            fill: none;
            stroke: rgba(220, 220, 220, 0.75);
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round;
            filter: blur(0.5px);
        }

        /* 触摸圈 - 只保留中心点 */
        .touch-circle {
            position: absolute;
            width: 8px;
            height: 8px;
            pointer-events: none;
            transform: translate(-50%, -50%);
            z-index: 100;
        }

        .touch-circle::after {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            width: 3px;
            height: 3px;
            background: rgba(200, 200, 200, 0.5);
            border-radius: 50%;
            transform: translate(-50%, -50%);
            box-shadow: 0 0 8px rgba(200, 200, 200, 0.4);
        }

        /* 感知文本 */
        .sensation {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            color: rgba(220, 220, 220, 0.9);
            font-size: 1.1rem;
            text-align: center;
            pointer-events: none;
            opacity: 0;
            transition: opacity 0.4s;
            max-width: 300px;
            line-height: 1.8;
            text-shadow: 0 0 20px rgba(0, 0, 0, 0.9);
            z-index: 50;
        }

        .sensation.visible {
            opacity: 1;
        }

        /* 句子卡片 */
        .sentence-card {
            position: absolute;
            padding: 20px 30px;
            background: rgba(40, 40, 40, 0.8);
            border: 2px solid rgba(120, 120, 120, 0.5);
            border-radius: 8px;
            color: rgba(220, 220, 220, 0.9);
            font-size: 1.1rem;
            cursor: grab;
            transition: all 0.3s;
            user-select: none;
            z-index: 10;
        }

        .sentence-card:hover {
            border-color: rgba(180, 180, 180, 0.8);
            background: rgba(50, 50, 50, 0.9);
            transform: scale(1.05);
        }

        .sentence-card.dragging {
            opacity: 0.7;
            cursor: grabbing;
            z-index: 1000;
        }

        .sentence-card.placed {
            background: rgba(60, 80, 60, 0.8);
            border-color: rgba(120, 180, 120, 0.7);
        }

        /* 排序区域 */
        .sort-area {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            display: flex;
            gap: 15px;
            z-index: 5;
        }

        .sort-slot {
            width: 80px;
            height: 120px;
            border: 3px dashed rgba(120, 120, 120, 0.4);
            border-radius: 8px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            background: rgba(30, 30, 30, 0.6);
            transition: all 0.3s;
            position: relative;
        }

        .sort-slot.highlight {
            border-color: rgba(180, 180, 180, 0.8);
            background: rgba(50, 50, 50, 0.8);
            border-style: solid;
        }

        .sort-slot .slot-number {
            font-size: 2.5rem;
            color: rgba(120, 120, 120, 0.5);
            font-weight: bold;
        }

        .sort-slot.filled .slot-number {
            font-size: 1rem;
            position: absolute;
            top: 10px;
            color: rgba(150, 150, 150, 0.7);
        }

        .sort-slot .sentence-text {
            font-size: 0.85rem;
            color: rgba(220, 220, 220, 0.9);
            text-align: center;
            padding: 10px;
            line-height: 1.4;
        }

        /* 提示文本 */
        .instruction {
            position: absolute;
            top: 30px;
            left: 50%;
            transform: translateX(-50%);
            color: rgba(180, 180, 180, 0.7);
            font-size: 1rem;
            text-align: center;
            z-index: 50;
            max-width: 600px;
            line-height: 1.6;
        }

        /* 声音开关 */
        .sound-toggle {
            position: absolute;
            top: 20px;
            right: 20px;
            background: none;
            border: 1px solid rgba(100, 100, 100, 0.3);
            color: rgba(150, 150, 150, 0.6);
            padding: 8px 12px;
            border-radius: 4px;
            cursor: pointer;
            font-size: 0.75rem;
            transition: all 0.2s;
            z-index: 1000;
        }

        .sound-toggle:hover,
        .sound-toggle:focus {
            border-color: rgba(150, 150, 150, 0.5);
            color: rgba(180, 180, 180, 0.8);
            outline: none;
        }

        /* 结束画面 */
        .end-screen {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.95);
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            transition: opacity 1s;
            pointer-events: none;
            z-index: 200;
        }

        .end-screen.visible {
            opacity: 1;
            pointer-events: all;
        }

        .end-message {
            text-align: center;
            color: rgba(220, 220, 220, 0.9);
            font-size: 1.5rem;
            line-height: 2;
            max-width: 500px;
            padding: 40px;
        }

        /* 屏幕阅读器 */
        .sr-only {
            position: absolute;
            width: 1px;
            height: 1px;
            padding: 0;
            margin: -1px;
            overflow: hidden;
            clip: rect(0, 0, 0, 0);
            white-space: nowrap;
            border-width: 0;
        }

        @media (max-width: 768px) {
            .sort-area {
                flex-wrap: wrap;
                max-width: 90vw;
            }
            .sort-slot {
                width: 70px;
                height: 100px;
            }
            .instruction {
                font-size: 0.9rem;
                padding: 0 20px;
            }
        }

        @media (prefers-reduced-motion: reduce) {
            * {
                animation-duration: 0.01ms !important;
                transition-duration: 0.01ms !important;
            }
        }
    </style>
</head>
<body>
    <!-- 场景 -->
    <div class="scene" id="scene" role="application" aria-label="探索区域" tabindex="0">

        <!-- SVG 场景 - 显示句子轮廓 -->
        <svg class="scene-svg" id="sceneSvg">
            <defs>
                <!-- 圆形遮罩 - 只显示触摸圈内的内容 -->
                <radialGradient id="touchGradient">
                    <stop offset="0%" stop-color="white" stop-opacity="1"/>
                    <stop offset="50%" stop-color="white" stop-opacity="0.7"/>
                    <stop offset="80%" stop-color="white" stop-opacity="0.3"/>
                    <stop offset="100%" stop-color="white" stop-opacity="0"/>
                </radialGradient>
                <mask id="touchMask">
                    <rect width="100%" height="100%" fill="black"/>
                    <circle id="maskCircle" r="60" fill="url(#touchGradient)"/>
                </mask>
            </defs>

            <!-- 句子轮廓层 -->
            <g id="sentenceOutlines" mask="url(#touchMask)"></g>
        </svg>

        <!-- 触摸圈 -->
        <div class="touch-circle" id="touchCircle"></div>

        <!-- 感知文本 -->
        <div class="sensation" id="sensation" role="status" aria-live="polite"></div>

        <!-- 提示文本 -->
        <div class="instruction" id="instruction">
            在黑暗中触摸散落的句子<br>
            根据音调高低排序（音调越高，顺序越靠后）
        </div>

        <!-- 排序区域 -->
        <div class="sort-area" id="sortArea">
            <div class="sort-slot" data-slot="1"><span class="slot-number">1</span></div>
            <div class="sort-slot" data-slot="2"><span class="slot-number">2</span></div>
            <div class="sort-slot" data-slot="3"><span class="slot-number">3</span></div>
            <div class="sort-slot" data-slot="4"><span class="slot-number">4</span></div>
            <div class="sort-slot" data-slot="5"><span class="slot-number">5</span></div>
            <div class="sort-slot" data-slot="6"><span class="slot-number">6</span></div>
        </div>

        <!-- 结束画面 -->
        <div class="end-screen" id="endScreen">
            <div class="end-message" id="endMessage"></div>
        </div>
    </div>

    <!-- 声音开关 -->
    <button class="sound-toggle" id="soundToggle" aria-pressed="true">声音</button>

    <!-- 屏幕阅读器 -->
    <div class="sr-only" role="status" aria-live="polite" id="liveRegion"></div>

    <script>
        // ============= 句子数据 =============
        const sentences = [
            { id: 1, text: '我看不见光明', tone: 'do', freq: 261.63, order: 1 },
            { id: 2, text: '只能依靠触摸', tone: 're', freq: 293.66, order: 2 },
            { id: 3, text: '感受物体的形状', tone: 'mi', freq: 329.63, order: 3 },
            { id: 4, text: '我的听觉很敏锐', tone: 'fa', freq: 349.23, order: 4 },
            { id: 5, text: '通过声音分辨事物', tone: 'sol', freq: 392.00, order: 5 },
            { id: 6, text: '触觉是我的眼睛', tone: 'la', freq: 440.00, order: 6 }
        ];

        // ============= 状态 =============
        const state = {
            soundOn: true,
            mouseX: window.innerWidth / 2,
            mouseY: window.innerHeight / 2,
            dragging: null,
            dragOffset: { x: 0, y: 0 },
            sentencePositions: [],
            slotContents: [null, null, null, null, null, null],
            completed: false,
            lastSoundTime: 0
        };

        // ============= DOM =============
        const el = {
            scene: document.getElementById('scene'),
            sceneSvg: document.getElementById('sceneSvg'),
            maskCircle: document.getElementById('maskCircle'),
            touchCircle: document.getElementById('touchCircle'),
            sensation: document.getElementById('sensation'),
            instruction: document.getElementById('instruction'),
            soundToggle: document.getElementById('soundToggle'),
            live: document.getElementById('liveRegion'),
            endScreen: document.getElementById('endScreen'),
            endMessage: document.getElementById('endMessage'),
            sortArea: document.getElementById('sortArea'),
            sentenceOutlines: document.getElementById('sentenceOutlines')
        };

        // ============= 音频 =============
        const Audio = {
            ctx: null,
            init() {
                try {
                    this.ctx = new (window.AudioContext || window.webkitAudioContext)();
                } catch (e) {}
            },
            tone(freq, dur, vol = 0.2) {
                if (!state.soundOn || !this.ctx) return;
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();
                osc.connect(gain);
                gain.connect(this.ctx.destination);
                osc.frequency.value = freq;
                osc.type = 'sine';
                gain.gain.setValueAtTime(vol, this.ctx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.01, this.ctx.currentTime + dur);
                osc.start();
                osc.stop(this.ctx.currentTime + dur);
            },
            playTone(freq) {
                const now = Date.now();
                if (now - state.lastSoundTime < 300) return;
                state.lastSoundTime = now;
                this.tone(freq, 0.4);
            },
            success() {
                this.tone(523, 0.2);
                setTimeout(() => this.tone(659, 0.2), 100);
                setTimeout(() => this.tone(784, 0.25), 200);
                setTimeout(() => this.tone(1047, 0.3), 300);
            }
        };

        // ============= 初始化场景 =============
        function initScene() {
            const w = window.innerWidth;
            const h = window.innerHeight;

            // 随机打乱句子顺序
            const shuffled = [...sentences].sort(() => Math.random() - 0.5);

            // 移除旧的句子卡片
            document.querySelectorAll('.sentence-card').forEach(card => card.remove());

            // 创建句子卡片和轮廓
            state.sentencePositions = [];
            el.sentenceOutlines.innerHTML = '';

            shuffled.forEach((sentence, index) => {
                // 随机位置（避开中央排序区域）
                let x, y;
                do {
                    x = 100 + Math.random() * (w - 300);
                    y = 100 + Math.random() * (h - 200);
                } while (
                    x > w/2 - 300 && x < w/2 + 300 &&
                    y > h/2 - 100 && y < h/2 + 100
                );

                // 创建卡片
                const card = document.createElement('div');
                card.className = 'sentence-card';
                card.textContent = sentence.text;
                card.dataset.id = sentence.id;
                card.dataset.tone = sentence.tone;
                card.dataset.freq = sentence.freq;
                card.style.left = x + 'px';
                card.style.top = y + 'px';

                // 添加事件监听
                card.addEventListener('mousedown', startDrag);
                card.addEventListener('touchstart', startDrag);
                card.addEventListener('mouseenter', () => {
                    if (!state.dragging) {
                        Audio.playTone(sentence.freq);
                    }
                });

                el.scene.appendChild(card);

                // 创建SVG轮廓
                const cardWidth = 200;
                const cardHeight = 80;
                const rect = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
                rect.classList.add('outline');
                rect.setAttribute('x', x - 10);
                rect.setAttribute('y', y - 10);
                rect.setAttribute('width', cardWidth);
                rect.setAttribute('height', cardHeight);
                rect.setAttribute('rx', 8);
                rect.dataset.id = sentence.id;
                el.sentenceOutlines.appendChild(rect);

                state.sentencePositions.push({
                    id: sentence.id,
                    x: x + cardWidth / 2,
                    y: y + cardHeight / 2,
                    text: sentence.text,
                    tone: sentence.tone,
                    freq: sentence.freq
                });
            });
        }

        // ============= 拖拽处理 =============
        function startDrag(e) {
            if (state.completed) return;

            e.preventDefault();
            const card = e.currentTarget;
            state.dragging = card;

            const rect = card.getBoundingClientRect();
            const clientX = e.touches ? e.touches[0].clientX : e.clientX;
            const clientY = e.touches ? e.touches[0].clientY : e.clientY;

            state.dragOffset = {
                x: clientX - rect.left,
                y: clientY - rect.top
            };

            card.classList.add('dragging');
            card.style.zIndex = 1000;

            // 播放音调
            Audio.playTone(parseFloat(card.dataset.freq));
        }

        function onMouseMove(e) {
            updateTouchPosition(e.clientX, e.clientY);

            if (state.dragging) {
                e.preventDefault();
                const x = e.clientX - state.dragOffset.x;
                const y = e.clientY - state.dragOffset.y;
                state.dragging.style.left = x + 'px';
                state.dragging.style.top = y + 'px';

                // 更新SVG轮廓位置
                const outline = el.sentenceOutlines.querySelector(`[data-id="${state.dragging.dataset.id}"]`);
                if (outline) {
                    outline.setAttribute('x', x - 10);
                    outline.setAttribute('y', y - 10);
                }

                checkSlotHighlight(e.clientX, e.clientY);
            }
        }

        function onTouchMove(e) {
            if (e.touches.length === 0) return;
            const touch = e.touches[0];

            updateTouchPosition(touch.clientX, touch.clientY);

            if (state.dragging) {
                e.preventDefault();
                const x = touch.clientX - state.dragOffset.x;
                const y = touch.clientY - state.dragOffset.y;
                state.dragging.style.left = x + 'px';
                state.dragging.style.top = y + 'px';

                // 更新SVG轮廓位置
                const outline = el.sentenceOutlines.querySelector(`[data-id="${state.dragging.dataset.id}"]`);
                if (outline) {
                    outline.setAttribute('x', x - 10);
                    outline.setAttribute('y', y - 10);
                }

                checkSlotHighlight(touch.clientX, touch.clientY);
            }
        }

        function endDrag(e) {
            if (!state.dragging) return;

            const clientX = e.changedTouches ? e.changedTouches[0].clientX : e.clientX;
            const clientY = e.changedTouches ? e.changedTouches[0].clientY : e.clientY;

            const slot = findSlotAtPosition(clientX, clientY);

            if (slot) {
                placeInSlot(state.dragging, slot);
            }

            state.dragging.classList.remove('dragging');
            state.dragging.style.zIndex = 10;
            state.dragging = null;

            // 移除所有高亮
            document.querySelectorAll('.sort-slot').forEach(s => s.classList.remove('highlight'));

            checkCompletion();
        }

        function checkSlotHighlight(x, y) {
            document.querySelectorAll('.sort-slot').forEach(slot => {
                slot.classList.remove('highlight');
            });

            const slot = findSlotAtPosition(x, y);
            if (slot) {
                slot.classList.add('highlight');
            }
        }

        function findSlotAtPosition(x, y) {
            const slots = document.querySelectorAll('.sort-slot');
            for (let slot of slots) {
                const rect = slot.getBoundingClientRect();
                if (x >= rect.left && x <= rect.right && y >= rect.top && y <= rect.bottom) {
                    return slot;
                }
            }
            return null;
        }

        function placeInSlot(card, slot) {
            const slotIndex = parseInt(slot.dataset.slot) - 1;
            const sentenceId = parseInt(card.dataset.id);

            // 如果槽位已有内容，移除旧的
            if (state.slotContents[slotIndex]) {
                const oldCard = document.querySelector(`[data-id="${state.slotContents[slotIndex]}"]`);
                if (oldCard) {
                    oldCard.classList.remove('placed');
                }
            }

            // 如果这个句子已在其他槽位，清除旧槽位
            const oldSlotIndex = state.slotContents.indexOf(sentenceId);
            if (oldSlotIndex !== -1) {
                state.slotContents[oldSlotIndex] = null;
                const oldSlot = document.querySelector(`.sort-slot[data-slot="${oldSlotIndex + 1}"]`);
                if (oldSlot) {
                    oldSlot.classList.remove('filled');
                    oldSlot.innerHTML = `<span class="slot-number">${oldSlotIndex + 1}</span>`;
                }
            }

            // 放置卡片
            state.slotContents[slotIndex] = sentenceId;
            card.classList.add('placed');

            // 更新槽位显示
            slot.classList.add('filled');
            slot.innerHTML = `
                <span class="slot-number">${slotIndex + 1}</span>
                <span class="sentence-text">${card.textContent}</span>
            `;

            // 隐藏卡片
            card.style.display = 'none';

            // 播放音调
            Audio.playTone(parseFloat(card.dataset.freq));
        }

        function checkCompletion() {
            // 检查是否所有槽位都已填充
            if (state.slotContents.some(s => s === null)) return;

            // 检查顺序是否正确
            const correct = state.slotContents.every((id, index) => id === index + 1);

            if (correct) {
                state.completed = true;
                Audio.success();

                setTimeout(() => {
                    showEnd();
                }, 1000);
            }
        }

        // ============= 触摸位置更新 =============
        function updateTouchPosition(x, y) {
            state.mouseX = x;
            state.mouseY = y;

            // 更新触摸圈位置
            el.touchCircle.style.left = x + 'px';
            el.touchCircle.style.top = y + 'px';

            // 更新遮罩圆位置
            el.maskCircle.setAttribute('cx', x);
            el.maskCircle.setAttribute('cy', y);

            // 检测触摸内容
            checkTouch(x, y);
        }

        function checkTouch(x, y) {
            let text = '';

            // 检测句子
            for (let pos of state.sentencePositions) {
                const dist = Math.sqrt(Math.pow(x - pos.x, 2) + Math.pow(y - pos.y, 2));

                if (dist < 80) {
                    text = pos.tone.toUpperCase() + '\n' + pos.text;
                    break;
                }
            }

            // 更新文本
            if (text) {
                el.sensation.textContent = text;
                el.sensation.classList.add('visible');
            } else {
                el.sensation.classList.remove('visible');
            }
        }

        // ============= 键盘控制 =============
        function onKeyDown(e) {
            const step = 25;
            let moved = false;

            switch(e.key) {
                case 'ArrowUp': state.mouseY = Math.max(60, state.mouseY - step); moved = true; break;
                case 'ArrowDown': state.mouseY = Math.min(window.innerHeight - 60, state.mouseY + step); moved = true; break;
                case 'ArrowLeft': state.mouseX = Math.max(60, state.mouseX - step); moved = true; break;
                case 'ArrowRight': state.mouseX = Math.min(window.innerWidth - 60, state.mouseX + step); moved = true; break;
            }

            if (moved) {
                e.preventDefault();
                updateTouchPosition(state.mouseX, state.mouseY);
            }
        }

        // ============= 结束画面 =============
        function showEnd() {
            el.instruction.style.opacity = 0;
            el.endMessage.innerHTML = '你理解了盲人的世界<br><br>黑暗中，触觉与听觉<br>是他们感知世界的方式';
            el.endScreen.classList.add('visible');
        }

        // ============= 辅助 =============
        function toggleSound() {
            state.soundOn = !state.soundOn;
            el.soundToggle.setAttribute('aria-pressed', state.soundOn);
        }

        function announce(msg) {
            el.live.textContent = msg;
            setTimeout(() => el.live.textContent = '', 1000);
        }

        // ============= 初始化 =============
        function init() {
            Audio.init();
            initScene();

            el.scene.addEventListener('mousemove', onMouseMove);
            el.scene.addEventListener('touchmove', onTouchMove, { passive: false });
            el.scene.addEventListener('mouseup', endDrag);
            el.scene.addEventListener('touchend', endDrag);
            el.scene.addEventListener('keydown', onKeyDown);
            el.soundToggle.addEventListener('click', toggleSound);

            window.addEventListener('resize', initScene);

            updateTouchPosition(state.mouseX, state.mouseY);
        }

        // ============= 启动 =============
        init();
    </script>
</body>
</html>
